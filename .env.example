# Copie este arquivo para .env (uso local) ou configure essas mesmas variáveis
# no painel da Vercel (Project Settings > Environment Variables) para produção.
# NUNCA coloque valores reais neste arquivo .env.example — ele é versionado no Git.

# Chave usada pelo Flask pra assinar sessões de login. Gere uma aleatória, por exemplo com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Credenciais do banco de dados Turso (deixe em branco para usar SQLite local em desenvolvimento)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Token do Vercel Blob (armazenamento de evidências em produção).
# É gerado automaticamente pela Vercel quando você cria um Blob Store no projeto —
# normalmente não precisa definir manualmente, a Vercel injeta sozinha.
BLOB_READ_WRITE_TOKEN=

# Gerado automaticamente pela Vercel quando você configura um Cron Job no projeto.
# Não precisa definir manualmente — só documentado aqui pra referência.
CRON_SECRET=
